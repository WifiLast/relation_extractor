+def _backbone(name: str, num_layers: Optional[int] = None):
+    """Build the encoder backbone from its config only.
+
+    The outer ``from_pretrained`` of the ReLiK reader restores every weight,
+    backbone included, so pre-loading the backbone here is redundant - and
+    transformers >= 5 builds the outer model under a meta-device context,
+    where a nested ``from_pretrained`` raises.
+    """
+    kwargs = {} if num_layers is None else {"num_hidden_layers": num_layers}
+    return AutoModel.from_config(AutoConfig.from_pretrained(name, **kwargs))
+
+
+_EMBEDDING_KEY = "transformer_model.embeddings.word_embeddings.weight"
+
+
+def _checkpoint_vocab_rows(name_or_path, **hub_kwargs) -> Optional[int]:
+    """Row count of the reader checkpoint's word-embedding matrix.
+
+    ReLiK checkpoints can hold a padded embedding matrix (e.g. 128128 rows for
+    DeBERTa-v3's 128100 + 24 special symbols). Rebuilding the model with the
+    unpadded size makes ``from_pretrained(ignore_mismatched_sizes=True)``
+    silently drop the fine-tuned embeddings, so the size is read from the
+    checkpoint itself (header / mmap only - no full load).
+    """
+    from transformers.utils import cached_file
+
+    hub_kwargs = {
+        k: v
+        for k, v in hub_kwargs.items()
+        if k in ("cache_dir", "force_download", "local_files_only", "token", "revision", "subfolder")
+    }
+    for filename in ("model.safetensors", "pytorch_model.bin"):
+        try:
+            path = cached_file(
+                name_or_path,
+                filename,
+                _raise_exceptions_for_missing_entries=False,
+                **hub_kwargs,
+            )
+        except Exception:
+            path = None
+        if not path:
+            continue
+        try:
+            if filename.endswith(".safetensors"):
+                from safetensors import safe_open
+
+                with safe_open(path, framework="pt") as f:
+                    if _EMBEDDING_KEY in f.keys():
+                        return int(f.get_slice(_EMBEDDING_KEY).get_shape()[0])
+            else:
+                state = torch.load(path, map_location="cpu", mmap=True, weights_only=True)
+                if _EMBEDDING_KEY in state:
+                    return int(state[_EMBEDDING_KEY].shape[0])
+        except Exception:
+            pass
+    return None
+
+
+def _resize_backbone_embeddings(model, config, extra_symbols: int) -> None:
+    target = model.transformer_model.config.vocab_size + extra_symbols
+    target = max(target, getattr(config, "checkpoint_vocab_size", None) or 0)
+    # mean_resizing=False: the checkpoint overwrites these rows anyway, and the
+    # mean-init path cannot run on the meta tensors transformers >= 5 uses.
+    model.transformer_model.resize_token_embeddings(target, mean_resizing=False)
+
+
+class _CheckpointVocabMixin:
+    @classmethod
+    def from_pretrained(cls, pretrained_model_name_or_path, *model_args, **kwargs):
+        config = kwargs.get("config")
+        if not isinstance(config, PretrainedConfig):
+            config = cls.config_class.from_pretrained(pretrained_model_name_or_path, **{
+                k: v for k, v in kwargs.items()
+                if k in ("cache_dir", "force_download", "local_files_only", "token", "revision", "subfolder")
+            })
+            kwargs["config"] = config
+        rows = _checkpoint_vocab_rows(pretrained_model_name_or_path, **kwargs)
+        if rows:
+            config.checkpoint_vocab_size = rows
+        return super().from_pretrained(pretrained_model_name_or_path, *model_args, **kwargs)
